# Pinned settings for the disposable test stack (compose.test.yml).
#
# These are throwaway values for a local server reachable only on
# localhost. They are committed on purpose, so the stack is the same on
# every machine and needs no setup. Do not reuse them for anything real.
# Bring the stack up with `pnpm backend:test:up`, which loads this file.

POSTGRES_PASSWORD=mindstream-test-postgres

# Kept off 3735 so a real server can run on this machine at the same time.
# The suites default to this port.
MINDSTREAM_PORT=18080
