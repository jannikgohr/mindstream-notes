# Settings for the Mindstream server when it runs under `docker compose`.
#
# Copy this file to `.env` in the same directory and edit it. Compose reads
# `.env` on its own, so after that it is just:
#
#   docker compose up -d --build
#
# Every setting and what it does is listed in README.md.

# Required. The database password. Make it long and random.
POSTGRES_PASSWORD=

# Who may create an account on this server.
#
#   closed   Only someone you gave a signup code. Make one with
#            `docker compose exec server mindstream-server signup-code create`.
#   invite   That, and someone holding an invite link whose maker let it
#            create an account. Choose it when the people on your server
#            should be able to bring in others without asking you.
#   open     Anyone who can reach the server.
MINDSTREAM_SIGNUP=closed

# The port on this machine the server answers on. Plain HTTP: put a reverse
# proxy with TLS in front for anything but local use.
MINDSTREAM_PORT=3735

# Hostnames clients use to reach the server, comma separated. Needed only
# when your reverse proxy does not pass the original Host header through,
# which shows as logins failing with `wrong_host`.
MINDSTREAM_PUBLIC_HOSTS=

# Where the page behind an invite link sends people who do not have the app.
# Empty keeps the default, the project's releases page.
MINDSTREAM_APP_URL=

# The key that seals authenticator secrets, 32 bytes as URL-safe base64.
# Empty makes the server create one in its data volume on first start. Back
# it up either way: without it nobody's authenticator works.
MINDSTREAM_SECRET_KEY=

# Lets another program set account limits over HTTP. Empty leaves that
# interface off, which is right for nearly every self-hosted server.
MINDSTREAM_ADMIN_TOKEN=
