{
  "id": "com.mindstream.typst.prototype",
  "name": "Typst Prototype",
  "version": "0.1.0",
  "author": "Mindstream",
  "enabledByDefault": false,
  "runtime": "luau",
  "entry": "main.luau",
  "descriptionKey": "plugin.description",
  "permissions": [
    "templates.contribute",
    "noteKinds.contribute",
    "notes.create",
    "nativeTools.runDeclared"
  ],
  "contributes": {
    "i18n": {
      "en": {
        "plugin.description": "Prototype Typst documents as plugin-owned notes.",
        "notes.document.label": "Typst document",
        "notes.document.description": "Source-and-preview document notes owned by the Typst plugin.",
        "templates.document.label": "Typst document",
        "native.typst.description": "Use the user-installed typst binary from PATH.",
        "settings.editor.title": "Editor",
        "settings.defaultViewMode.label": "Default view mode"
      },
      "de": {
        "plugin.description": "Prototyp fuer Typst-Dokumente als Plugin-Notizen.",
        "notes.document.label": "Typst-Dokument",
        "notes.document.description": "Quelltext- und Vorschau-Notizen des Typst-Plugins.",
        "templates.document.label": "Typst-Dokument",
        "native.typst.description": "Verwendet das vom Benutzer installierte typst-Binary aus PATH.",
        "settings.editor.title": "Editor",
        "settings.defaultViewMode.label": "Standardansicht"
      }
    },
    "settings": [
      {
        "sectionId": "editor",
        "titleKey": "settings.editor.title",
        "settings": [
          {
            "id": "default-view-mode",
            "labelKey": "settings.defaultViewMode.label",
            "scope": "D",
            "type": "select",
            "default": "split",
            "options": ["split", "source", "wysiwyg"]
          }
        ]
      }
    ],
    "nativeTools": [
      {
        "id": "typst",
        "binaryName": "typst",
        "descriptionKey": "native.typst.description"
      }
    ],
    "noteKinds": [
      {
        "id": "document",
        "labelKey": "notes.document.label",
        "descriptionKey": "notes.document.description",
        "sourceLanguage": "typst",
        "viewModePreviewIcon": "bookText",
        "defaultTitle": "Untitled Typst document",
        "defaultBody": "#set document(title: [Untitled])\n\n= Untitled\n\nStart writing in Typst here.",
        "render": {
          "export": "renderDocument",
          "previewMime": "text/html",
          "debounceMs": 300,
          "webview": {
            "entry": "preview.mjs"
          }
        }
      }
    ],
    "noteTemplates": [
      {
        "id": "document",
        "labelKey": "templates.document.label",
        "noteKind": "plugin.com.mindstream.typst.prototype.document",
        "titleTemplate": "Untitled Typst document",
        "bodyTemplate": "#set document(title: [{{title}}])\n\n= {{title}}\n\nStart writing in Typst here."
      }
    ],
    "toolbar": [
      {
        "id": "heading",
        "location": "note-editor",
        "noteKind": "document",
        "toolbarItem": "h1",
        "action": {
          "type": "insertText",
          "text": "= ",
          "cursorOffset": 2
        }
      },
      {
        "id": "strong",
        "location": "note-editor",
        "noteKind": "document",
        "toolbarItem": "bold",
        "action": {
          "type": "wrapSelection",
          "before": "*",
          "after": "*",
          "placeholder": "strong"
        }
      },
      {
        "id": "emphasis",
        "location": "note-editor",
        "noteKind": "document",
        "toolbarItem": "italic",
        "action": {
          "type": "wrapSelection",
          "before": "_",
          "after": "_",
          "placeholder": "emphasis"
        }
      },
      {
        "id": "math",
        "location": "note-editor",
        "noteKind": "document",
        "toolbarItem": "math",
        "action": {
          "type": "wrapSelection",
          "before": "$ ",
          "after": " $",
          "placeholder": "x^2"
        }
      },
      {
        "id": "list",
        "location": "note-editor",
        "noteKind": "document",
        "toolbarItem": "bullet",
        "action": {
          "type": "insertText",
          "text": "- ",
          "cursorOffset": 2
        }
      }
    ]
  }
}
