{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mindstream Vault Runtime Spike",
  "version": "0.0.0",
  "identifier": "com.jannikgohr.mindstream-vault-runtime-spike",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
