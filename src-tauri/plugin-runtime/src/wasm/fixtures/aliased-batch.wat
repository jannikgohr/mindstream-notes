;; Batch types mirror plugin-sdk/wit/batch.wit. No guest compiler is needed.
(component
  (type $ty-mindstream:plugin/runtime@0.1.0 (;0;)
    (instance
      (type (;0;) (enum "debug" "info" "warn" "error"))
      (export (;1;) "log-level" (type (eq 0)))
    )
  )
  (import "mindstream:plugin/runtime@0.1.0" (instance $mindstream:plugin/runtime@0.1.0 (;0;) (type $ty-mindstream:plugin/runtime@0.1.0)))
  (type $ty-mindstream:plugin/types@0.1.0 (;1;)
    (instance
      (type (;0;) (list string))
      (type (;1;) (option string))
      (type (;2;) (record (field "id" string) (field "title" string) (field "tags" 0) (field "kind" string) (field "folder-id" 1) (field "folder-path" string) (field "created" string) (field "modified" string)))
      (export (;3;) "note-meta" (type (eq 2)))
      (type (;4;) (variant (case "denied" string) (case "invalid" string) (case "unavailable" string) (case "failed" string)))
      (export (;5;) "error" (type (eq 4)))
    )
  )
  (import "mindstream:plugin/types@0.1.0" (instance $mindstream:plugin/types@0.1.0 (;1;) (type $ty-mindstream:plugin/types@0.1.0)))
  (type $ty-mindstream:plugin/clock@0.1.0 (;2;)
    (instance
      (type (;0;) (enum "second" "minute" "hour" "day" "week" "month" "year"))
      (export (;1;) "time-unit" (type (eq 0)))
    )
  )
  (import "mindstream:plugin/clock@0.1.0" (instance $mindstream:plugin/clock@0.1.0 (;2;) (type $ty-mindstream:plugin/clock@0.1.0)))
  (type $ty-mindstream:plugin/storage@0.1.0 (;3;)
    (instance
      (type (;0;) (record (field "name" string) (field "is-dir" bool) (field "size-bytes" u64)))
      (export (;1;) "entry" (type (eq 0)))
    )
  )
  (import "mindstream:plugin/storage@0.1.0" (instance $mindstream:plugin/storage@0.1.0 (;3;) (type $ty-mindstream:plugin/storage@0.1.0)))
  (type $ty-mindstream:plugin/native-tools@0.1.0 (;4;)
    (instance
      (type (;0;) (option s32))
      (type (;1;) (option string))
      (type (;2;) (record (field "status-code" 0) (field "stdout" string) (field "stdout-base64" 1) (field "stderr" string) (field "timed-out" bool)))
      (export (;3;) "run-output" (type (eq 2)))
    )
  )
  (import "mindstream:plugin/native-tools@0.1.0" (instance $mindstream:plugin/native-tools@0.1.0 (;4;) (type $ty-mindstream:plugin/native-tools@0.1.0)))
  (alias export $mindstream:plugin/runtime@0.1.0 "log-level" (type $log-level (;5;)))
  (alias export $mindstream:plugin/clock@0.1.0 "time-unit" (type $time-unit (;6;)))
  (alias export $mindstream:plugin/types@0.1.0 "note-meta" (type $note-meta (;7;)))
  (alias export $mindstream:plugin/storage@0.1.0 "entry" (type $entry (;8;)))
  (alias export $mindstream:plugin/native-tools@0.1.0 "run-output" (type $run-output (;9;)))
  (alias export $mindstream:plugin/types@0.1.0 "error" (type $error (;10;)))
  (type $ty-mindstream:plugin/batch@0.1.0 (;11;)
    (instance
      (alias outer 1 $log-level (type (;0;)))
      (export (;1;) "log-level" (type (eq 0)))
      (type (;2;) (variant (case "literal" string) (case "previous" u32)))
      (export (;3;) "text-input" (type (eq 2)))
      (type (;4;) (record (field "level" 1) (field "message" 3)))
      (export (;5;) "log-request" (type (eq 4)))
      (type (;6;) (option 3))
      (type (;7;) (record (field "timestamp" 3) (field "pattern" 3) (field "locale" 6)))
      (export (;8;) "format-request" (type (eq 7)))
      (alias outer 1 $time-unit (type (;9;)))
      (export (;10;) "time-unit" (type (eq 9)))
      (type (;11;) (record (field "timestamp" 3) (field "amount" s64) (field "unit" 10)))
      (export (;12;) "add-request" (type (eq 11)))
      (type (;13;) (record (field "path" 3) (field "contents" 3)))
      (export (;14;) "write-request" (type (eq 13)))
      (type (;15;) (list 3))
      (type (;16;) (option u32))
      (type (;17;) (record (field "tool-id" 3) (field "args" 15) (field "stdin" 6) (field "timeout-ms" 16) (field "output-base64" bool)))
      (export (;18;) "tool-request" (type (eq 17)))
      (type (;19;) (variant (case "log" 5) (case "uuid") (case "random-bytes" u32) (case "has-permission" 3) (case "now-millis") (case "now") (case "clock-format" 8) (case "clock-add" 12) (case "frontmatter" 3) (case "notes-all") (case "notes-get" 3) (case "storage-read" 3) (case "storage-list" 3) (case "storage-write" 14) (case "storage-delete" 3) (case "tool-available" 3) (case "tool-run" 18)))
      (export (;20;) "operation" (type (eq 19)))
      (type (;21;) (record (field "operation" 20) (field "keep" bool)))
      (export (;22;) "command" (type (eq 21)))
      (alias outer 1 $note-meta (type (;23;)))
      (export (;24;) "note-meta" (type (eq 23)))
      (alias outer 1 $entry (type (;25;)))
      (export (;26;) "entry" (type (eq 25)))
      (alias outer 1 $run-output (type (;27;)))
      (export (;28;) "run-output" (type (eq 27)))
      (type (;29;) (option string))
      (type (;30;) (list u8))
      (type (;31;) (list 24))
      (type (;32;) (option 24))
      (type (;33;) (list 26))
      (type (;34;) (variant (case "none") (case "text" string) (case "optional-text" 29) (case "number" u64) (case "boolean" bool) (case "bytes" 30) (case "notes" 31) (case "note" 32) (case "entries" 33) (case "tool" 28)))
      (export (;35;) "value" (type (eq 34)))
      (type (;36;) (record (field "index" u32) (field "value" 35)))
      (export (;37;) "reply" (type (eq 36)))
      (type (;38;) (enum "validation" "execution" "result-limit"))
      (export (;39;) "failure-phase" (type (eq 38)))
      (alias outer 1 $error (type (;40;)))
      (export (;41;) "error" (type (eq 40)))
      (type (;42;) (list 37))
      (type (;43;) (record (field "index" u32) (field "phase" 39) (field "completed" u32) (field "replies" 42) (field "cause" 41)))
      (export (;44;) "failure" (type (eq 43)))
      (type (;45;) (list 22))
      (type (;46;) (result 42 (error 44)))
      (type (;47;) (func (param "commands" 45) (result 46)))
      (export (;0;) "execute" (func (type 47)))
    )
  )
  (import "mindstream:plugin/batch@0.1.0" (instance $mindstream:plugin/batch@0.1.0 (;5;) (type $ty-mindstream:plugin/batch@0.1.0)))

  ;; Each command points to the same bytes. An owned Vec<Command> would copy
  ;; that text once per command before the host's batch validator can run.
  (core module $memory
    (memory (export "memory") 32)
    (global $next (mut i32) (i32.const 1500000))
    (func (export "realloc") (param i32 i32) (param $align i32) (param $size i32) (result i32)
      (local $ptr i32)
      (local.set $ptr (i32.and
        (i32.add (global.get $next) (i32.sub (local.get $align) (i32.const 1)))
        (i32.sub (i32.const 0) (local.get $align))))
      (global.set $next (i32.add (local.get $ptr) (local.get $size)))
      (local.get $ptr))
    (data (i32.const 128) "truefalse"))
  (core instance $memory-instance (instantiate $memory))
  (alias core export $memory-instance "memory" (core memory $memory))
  (alias core export $memory-instance "realloc" (core func $realloc))
  (alias export $mindstream:plugin/batch@0.1.0 "execute" (func $execute))
  (core func $execute (canon lower (func $execute) (memory $memory) (realloc $realloc)))
  (core module $guest
    (import "host" "execute" (func $execute (param i32 i32 i32)))
    (import "memory" "memory" (memory 32))
    (func (export "invoke") (param $export i32) (param i32 i32 i32) (result i32)
      (local $count i32) (local $length i32) (local $i i32) (local $base i32)
      (local.set $count (i32.const 1))
      (local.set $length (i32.const 1048576))
      ;; "amplify": 120 aliases of 1 MiB, from a 2 MiB guest memory.
      (if (i32.eq (i32.load8_u (local.get $export)) (i32.const 97))
        (then (local.set $count (i32.const 120))))
      ;; "validation": 2 MiB fits lifting but exceeds the batch literal cap.
      (if (i32.eq (i32.load8_u (local.get $export)) (i32.const 118))
        (then (local.set $count (i32.const 2))))
      ;; "maximum": all 128 commands sum to exactly 1 MiB of literal data.
      (if (i32.eq (i32.load8_u (local.get $export)) (i32.const 109))
        (then
          (local.set $count (i32.const 128))
          (local.set $length (i32.const 8192))))
      (loop $commands
        (local.set $base (i32.add (i32.const 4096) (i32.mul (local.get $i) (i32.const 64))))
        ;; operation = has-permission, text-input = literal, keep = false.
        (i32.store8 (local.get $base) (i32.const 3))
        (i32.store offset=12 (local.get $base) (i32.const 65536))
        (i32.store offset=16 (local.get $base) (local.get $length))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br_if $commands (i32.lt_u (local.get $i) (local.get $count))))
      (call $execute (i32.const 4096) (local.get $count) (i32.const 2048))
      ;; Return JSON true for a successful batch, false for a batch failure.
      (i32.store (i32.const 0) (i32.const 0))
      (if (i32.eqz (i32.load8_u (i32.const 2048)))
        (then
          (i32.store (i32.const 4) (i32.const 128))
          (i32.store (i32.const 8) (i32.const 4)))
        (else
          (i32.store (i32.const 4) (i32.const 132))
          (i32.store (i32.const 8) (i32.const 5))))
      (i32.const 0)))
  (core instance $host (export "execute" (func $execute)))
  (core instance $guest-instance (instantiate $guest
    (with "host" (instance $host))
    (with "memory" (instance $memory-instance))))
  (type $result (result string (error string)))
  (type $invoke (func (param "export" string) (param "input" string) (result $result)))
  (func (export "invoke") (type $invoke)
    (canon lift (core func $guest-instance "invoke") (memory $memory) (realloc $realloc))))
