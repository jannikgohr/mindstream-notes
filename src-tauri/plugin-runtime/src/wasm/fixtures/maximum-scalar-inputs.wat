;; Exercises scalar argument limits directly, without a guest JSON parser.
(component
  (import "mindstream:plugin/types@0.1.0" (instance $types
    (type $error (variant (case "denied" string) (case "invalid" string)
      (case "unavailable" string) (case "failed" string)))
    (export "error" (type (eq $error)))))
  (alias export $types "error" (type $error))
  (import "mindstream:plugin/native-tools@0.1.0" (instance $tools
    (alias outer 1 $error (type $error))
    (export "error" (type $tool-error (eq $error)))
    (type $args (list string))
    (type $stdin (option string))
    (type $timeout (option u32))
    (type $options (record (field "args" $args) (field "stdin" $stdin)
      (field "timeout-ms" $timeout) (field "output-base64" bool)))
    (export "run-options" (type $run-options (eq $options)))
    (type $status (option s32))
    (type $output (record (field "status-code" $status) (field "stdout" string)
      (field "stdout-base64" $stdin) (field "stderr" string) (field "timed-out" bool)))
    (export "run-output" (type $run-output (eq $output)))
    (type $result (result $run-output (error $tool-error)))
    (export "run" (func (param "tool-id" string) (param "options" $run-options) (result $result)))))
  (import "mindstream:plugin/storage@0.1.0" (instance $storage
    (alias outer 1 $error (type $error))
    (export "error" (type $storage-error (eq $error)))
    (type $result (result (error $storage-error)))
    (export "write" (func (param "path" string) (param "contents" string) (result $result)))))
  (core module $memory
    (memory (export "memory") 160)
    (global $next (mut i32) (i32.const 9437184))
    (func (export "realloc") (param i32 i32) (param $align i32) (param $size i32) (result i32)
      (local $ptr i32)
      (local.set $ptr (i32.and
        (i32.add (global.get $next) (i32.sub (local.get $align) (i32.const 1)))
        (i32.sub (i32.const 0) (local.get $align))))
      (global.set $next (i32.add (local.get $ptr) (local.get $size)))
      (local.get $ptr))
    (data (i32.const 128) "true")
    (data (i32.const 256) "missing")
    (data (i32.const 264) "large.txt"))
  (core instance $memory-instance (instantiate $memory))
  (alias core export $memory-instance "memory" (core memory $memory))
  (alias core export $memory-instance "realloc" (core func $realloc))
  (alias export $tools "run" (func $run))
  (alias export $storage "write" (func $write))
  (core func $run (canon lower (func $run) (memory $memory) (realloc $realloc)))
  (core func $write (canon lower (func $write) (memory $memory) (realloc $realloc)))
  (core module $guest
    (import "host" "run" (func $run (param i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)))
    (import "host" "write" (func $write (param i32 i32 i32 i32 i32)))
    (import "memory" "memory" (memory 160))
    (func (export "invoke") (param i32 i32 i32 i32) (result i32)
      (local $i i32) (local $base i32)
      ;; 8 MiB stdin, with the first 4096 bytes also backing all 64 arguments.
      (memory.fill (i32.const 65536) (i32.const 120) (i32.const 8388608))
      (loop $args
        (local.set $base (i32.add (i32.const 4096) (i32.mul (local.get $i) (i32.const 8))))
        (i32.store (local.get $base) (i32.const 65536))
        (i32.store offset=4 (local.get $base) (i32.const 4096))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br_if $args (i32.lt_u (local.get $i) (i32.const 64))))
      (local.set $i (i32.const 0))
      ;; Each call fits 9 MiB; together they exceed it. The budget must reset.
      (loop $calls
        (call $run (i32.const 256) (i32.const 7) (i32.const 4096) (i32.const 64)
          (i32.const 1) (i32.const 65536) (i32.const 8388608)
          (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 2048))
        ;; The declared, unavailable tool must reach the normal host refusal.
        (if (i32.ne (i32.load8_u (i32.const 2048)) (i32.const 1)) (then unreachable))
        (if (i32.ne (i32.load8_u (i32.const 2052)) (i32.const 2)) (then unreachable))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br_if $calls (i32.lt_u (local.get $i) (i32.const 2))))
      ;; A maximum-sized storage write must also pass through the bindings.
      (call $write (i32.const 264) (i32.const 9) (i32.const 65536)
        (i32.const 4194304) (i32.const 2048))
      (if (i32.ne (i32.load8_u (i32.const 2048)) (i32.const 0)) (then unreachable))
      (i32.store (i32.const 0) (i32.const 0))
      (i32.store (i32.const 4) (i32.const 128))
      (i32.store (i32.const 8) (i32.const 4))
      (i32.const 0)))
  (core instance $host (export "run" (func $run)) (export "write" (func $write)))
  (core instance $guest-instance (instantiate $guest
    (with "host" (instance $host)) (with "memory" (instance $memory-instance))))
  (type $result (result string (error string)))
  (type $invoke (func (param "export" string) (param "input" string) (result $result)))
  (func (export "invoke") (type $invoke)
    (canon lift (core func $guest-instance "invoke") (memory $memory) (realloc $realloc))))
