{
  "protocol": 1,
  "frames": {
    "hello": 1,
    "welcome": 2,
    "joined": 3,
    "left": 4,
    "access": 5
  },
  "classes": {
    "update": 16,
    "sync": 17,
    "reply": 18,
    "presence": 32
  },
  "classesThatNeedWriteAccess": ["update", "reply"],
  "accessLevels": {
    "readOnly": 0,
    "admin": 1,
    "readWrite": 2
  },
  "closeCodes": {
    "badFrame": 4400,
    "unauthorized": 4401,
    "removed": 4403,
    "slow": 4408,
    "tooMany": 4429,
    "unavailable": 1013
  },
  "senderBytes": 4,
  "examples": {
    "hello": {
      "hex": "017469636b6574",
      "ticket": "ticket"
    },
    "sent": {
      "hex": "100a0b0c",
      "class": "update",
      "payload": "0a0b0c"
    },
    "sentReply": {
      "hex": "12000000020d0e",
      "class": "reply",
      "target": 2,
      "payload": "0d0e"
    },
    "relayed": {
      "hex": "10000000010a0b0c",
      "class": "update",
      "sender": 1,
      "payload": "0a0b0c"
    },
    "welcome": {
      "frame": "welcome",
      "body": {
        "you": 2,
        "accessLevel": 0,
        "peers": [{ "id": 1, "username": "ann", "accessLevel": 1 }]
      }
    },
    "joined": {
      "frame": "joined",
      "body": { "id": 2, "username": "bob", "accessLevel": 0 }
    },
    "left": {
      "frame": "left",
      "body": { "id": 2 }
    },
    "access": {
      "frame": "access",
      "body": { "accessLevel": 2 }
    }
  },
  "exchange": [
    {
      "join": "ann",
      "access": "admin",
      "then": [
        {
          "to": "ann",
          "frame": "welcome",
          "body": { "you": "ann", "accessLevel": "admin", "peers": [] }
        }
      ]
    },
    {
      "join": "bob",
      "access": "readOnly",
      "then": [
        {
          "to": "bob",
          "frame": "welcome",
          "body": {
            "you": "bob",
            "accessLevel": "readOnly",
            "peers": [
              { "id": "ann", "username": "ann", "accessLevel": "admin" }
            ]
          }
        },
        {
          "to": "ann",
          "frame": "joined",
          "body": { "id": "bob", "username": "bob", "accessLevel": "readOnly" }
        }
      ]
    },
    {
      "send": "ann",
      "class": "update",
      "payload": "0a0b0c",
      "then": [
        { "to": "bob", "class": "update", "sender": "ann", "payload": "0a0b0c" }
      ]
    },
    {
      "send": "bob",
      "class": "update",
      "payload": "ff",
      "then": []
    },
    {
      "send": "bob",
      "class": "presence",
      "payload": "01",
      "then": [
        { "to": "ann", "class": "presence", "sender": "bob", "payload": "01" }
      ]
    },
    {
      "send": "bob",
      "class": "sync",
      "payload": "02",
      "then": [
        { "to": "ann", "class": "sync", "sender": "bob", "payload": "02" }
      ]
    },
    {
      "send": "ann",
      "class": "reply",
      "target": "bob",
      "payload": "0d0e",
      "then": [
        { "to": "bob", "class": "reply", "sender": "ann", "payload": "0d0e" }
      ]
    },
    {
      "setAccess": "bob",
      "access": "readWrite",
      "then": [
        {
          "to": "bob",
          "frame": "access",
          "body": { "accessLevel": "readWrite" }
        }
      ]
    },
    {
      "send": "bob",
      "class": "update",
      "payload": "ee",
      "then": [
        { "to": "ann", "class": "update", "sender": "bob", "payload": "ee" }
      ]
    },
    {
      "leave": "bob",
      "then": [{ "to": "ann", "frame": "left", "body": { "id": "bob" } }]
    }
  ]
}
